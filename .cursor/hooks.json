{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "./scripts/hooks/session-start.sh", "timeout": 30 }
    ],
    "beforeShellExecution": [
      { "command": "./scripts/hooks/guard.sh", "timeout": 10, "failClosed": true }
    ],
    "afterShellExecution": [
      { "command": "./scripts/hooks/audit.sh", "timeout": 10 }
    ],
    "preToolUse": [
      { "command": "./scripts/hooks/protect.sh", "matcher": "Write|StrReplace|Delete|EditNotebook|Read", "timeout": 10, "failClosed": true },
      { "command": "./scripts/hooks/mcp-guard.sh", "matcher": "WebFetch|WebSearch", "timeout": 10, "failClosed": true }
    ],
    "beforeReadFile": [
      { "command": "./scripts/hooks/protect.sh", "timeout": 10, "failClosed": true }
    ],
    "beforeMCPExecution": [
      { "command": "./scripts/hooks/mcp-guard.sh", "timeout": 10, "failClosed": true }
    ],
    "stop": [
      { "command": "./scripts/hooks/stop.sh", "timeout": 30, "loop_limit": 5 }
    ]
  }
}
